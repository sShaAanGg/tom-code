#!/usr/bin/env bash
# Strip Claude co-author trailers from the commit message.
# Only matches Claude/Anthropic trailers, so human co-authors are kept.
set -euo pipefail

msg_file="$1"
sed -E '/^[Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|noreply@anthropic\.com)/d' "$msg_file" > "$msg_file.tmp"
mv "$msg_file.tmp" "$msg_file"
